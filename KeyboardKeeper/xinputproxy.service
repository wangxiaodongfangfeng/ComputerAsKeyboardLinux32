[Unit]
Description=XInput TCP Server with xinput support
After=network.target
Wants=network.target
Documentation=https://your-documentation-url

[Service]
# 使用非root用户运行
User=ford
Group=ford

# 程序路径配置
WorkingDirectory=/home/ford/ford-keyboard
ExecStart=/home/ford/ford-keyboard/xinputproxy -p 9869

# 关键：允许服务执行xinput所需的权限设置
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
NoNewPrivileges=false

# 环境变量配置
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/ford/.Xauthority"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# 服务管理配置
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=30

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xinputproxy

[Install]
WantedBy=multi-user.target